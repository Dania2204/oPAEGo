# Copie este archivo como .env y ajuste los valores.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Motor de base de datos (RNF-17): se cambia solo con esta URL.
DATABASE_URL=postgres://pae_user:pae_password@localhost:5434/pae_go
# Pruebas contra PostgreSQL (opcional; por defecto SQLite en memoria)
# TEST_DATABASE_URL=postgres://pae_user:pae_password@localhost:5434/pae_go_test

# JWT (RF-01, RF-02, RNF-08)
JWT_ACCESS_MIN=10
JWT_INACTIVIDAD_MIN=30
JWT_COOKIE_SECURE=False

# Orígenes de la app móvil / otros clientes (CORS)
CORS_ALLOWED_ORIGINS=

# Correo para restablecer contraseñas (RF-03). En desarrollo se imprime en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@paego.local
URL_PUBLICA=http://localhost:8000

# Reglas de negocio
PAEGO_TOLERANCIA_ENTREGA_MIN=30
PAEGO_INTERVALO_UBICACION_SEG=15
PAEGO_INTERVALO_MAPA_SEG=10
PAEGO_UMBRAL_DIFERIDO_MIN=5
PAEGO_TOLERANCIA_RELOJ_MIN=5

# Límite de intentos por IP (contra fuerza bruta). Al superarlo: HTTP 429.
# LIMITE_LOGIN=10/min
# LIMITE_RENOVAR=30/min
# LIMITE_RESTABLECER=5/hour
# LIMITE_NUTRICION=20/hour   (asistente de nutrición, por usuario)
# Caché de esos contadores. Con varios workers de gunicorn, usar una compartida:
# CACHE_URL=dbcache://cache_paego   (luego: python manage.py createcachetable)

# Asistente de nutrición de la app móvil (Gemini). La clave queda solo en el servidor.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SEG=30

# Registros: texto (desarrollo) o json (producción por defecto). Nivel: DEBUG, INFO, WARNING…
# LOG_FORMATO=texto
# LOG_NIVEL=INFO
# Sentry (opcional, solo producción): errores no controlados, sin datos personales.
# SENTRY_DSN=
# SENTRY_ENTORNO=produccion
# SENTRY_MUESTREO_TRAZAS=0.0
